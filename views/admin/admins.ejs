<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Voodo - Administrators</title>

  <link rel="stylesheet" href="/css/style.css">

  <style>

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      font-size: 13px;
      color: #6b7280;
      font-weight: 600;
    }

    input {
      padding: 11px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      font-family: inherit;
    }

    .submit-btn {
      margin-top: 20px;
      padding: 11px 20px;
      border: none;
      border-radius: 7px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      cursor: pointer;
    }

    .error {
      background: #fee2e2;
      color: #991b1b;
      padding: 12px;
      border-radius: 7px;
      margin-bottom: 18px;
    }

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 14px;
      border-bottom: 1px solid #e5e7eb;
    }

    th {
      color: #6b7280;
      font-size: 13px;
    }

    .admin-badge {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      background: #dbeafe;
      color: #1e40af;
      font-size: 12px;
      font-weight: 600;
    }

    @media (max-width: 700px) {

      .form-grid {
        grid-template-columns: 1fr;
      }

      .full {
        grid-column: auto;
      }

    }

  </style>

</head>

<body>

<div class="app">

  <aside class="sidebar">

    <div class="brand">
      Voodo
    </div>

    <nav>

      <a href="/admin/dashboard">
        Dashboard
      </a>

      <a href="/admin/employees">
        Employees
      </a>

      <a href="/admin/attendance">
        Attendance
      </a>

      <a href="/payroll/admin">
        Payroll
      </a>

      <a href="/admin/leaves">
        Leave Requests
      </a>

      <a href="/admin/admins" class="active">
        Administrators
      </a>

    </nav>

    <a href="/logout" class="logout">
      Logout
    </a>

  </aside>


  <main class="main">

    <header class="topbar">

      <div>

        <h1>Administrators</h1>

        <p>
          Manage Voodo administrator accounts
        </p>

      </div>

    </header>


    <div class="panel">

      <div class="panel-header">

        <h2>Add Administrator</h2>

      </div>


      <% if (error) { %>

        <div class="error">
          <%= error %>
        </div>

      <% } %>


      <form action="/admin/admins/create" method="POST">

        <div class="form-grid">

          <div class="form-group">

            <label>Full Name</label>

            <input
              type="text"
              name="name"
              placeholder="Administrator name"
              required
            >

          </div>


          <div class="form-group">

            <label>Email</label>

            <input
              type="email"
              name="email"
              placeholder="admin@company.com"
              required
            >

          </div>


          <div class="form-group">

            <label>Password</label>

            <input
              type="password"
              name="password"
              placeholder="Minimum 6 characters"
              minlength="6"
              required
            >

          </div>


          <div class="form-group">

            <label>Department</label>

            <input
              type="text"
              name="department"
              value="Administration"
            >

          </div>


          <div class="form-group">

            <label>Job Title</label>

            <input
              type="text"
              name="jobTitle"
              value="HR Administrator"
            >

          </div>

        </div>


        <button
          type="submit"
          class="submit-btn"
        >
          Create Administrator
        </button>

      </form>

    </div>


    <div class="panel" style="margin-top: 20px;">

      <div class="panel-header">

        <h2>Administrator Accounts</h2>

      </div>


      <div class="table-container">

        <table>

          <thead>

            <tr>
              <th>Admin ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Department</th>
              <th>Role</th>
            </tr>

          </thead>


          <tbody>

            <% admins.forEach(admin => { %>

              <tr>

                <td>
                  <%= admin.employeeId %>
                </td>

                <td>
                  <strong>
                    <%= admin.name %>
                  </strong>
                </td>

                <td>
                  <%= admin.email %>
                </td>

                <td>
                  <%= admin.department || "-" %>
                </td>

                <td>

                  <span class="admin-badge">
                    Administrator
                  </span>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>

  </main>

</div>

</body>

</html>