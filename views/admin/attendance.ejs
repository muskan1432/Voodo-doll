<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Voodo - Attendance</title>

  <link rel="stylesheet" href="/css/style.css">

  <style>

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 14px;
      border-bottom: 1px solid #e5e7eb;
    }

    th {
      color: #6b7280;
      font-size: 13px;
    }

    .status {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .present {
      background: #dcfce7;
      color: #166534;
    }

    .absent {
      background: #fee2e2;
      color: #991b1b;
    }

    .half-day {
      background: #fef3c7;
      color: #92400e;
    }

    .leave {
      background: #dbeafe;
      color: #1e40af;
    }

    .empty-state {
      color: #6b7280;
      padding: 20px;
    }

  </style>

</head>

<body>

<div class="app">

  <aside class="sidebar">

    <div class="brand">
      Voodo
    </div>

    <nav>

      <a href="/admin/dashboard">
        Dashboard
      </a>

      <a href="/admin/employees">
        Employees
      </a>

      <a href="/admin/attendance" class="active">
        Attendance
      </a>

      <a href="/payroll/admin">
        Payroll
      </a>

      <a href="/admin/leaves">
        Leave Requests
      </a>

    </nav>

    <a href="/logout" class="logout">
      Logout
    </a>

  </aside>


  <main class="main">

    <header class="topbar">

      <div>

        <h1>Attendance</h1>

        <p>
          Monitor employee attendance
        </p>

      </div>

    </header>


    <div class="panel">

      <div class="panel-header">

        <h2>Attendance Records</h2>

      </div>


      <div class="table-container">

        <table>

          <thead>

            <tr>

              <th>Employee</th>
              <th>Department</th>
              <th>Date</th>
              <th>Check In</th>
              <th>Check Out</th>
              <th>Status</th>

            </tr>

          </thead>


          <tbody>

            <% if (attendance.length === 0) { %>

              <tr>

                <td colspan="6" class="empty-state">
                  No attendance records available.
                </td>

              </tr>

            <% } %>


            <% attendance.forEach(record => { %>

              <tr>

                <td>

                  <strong>
                    <%= record.employee.name %>
                  </strong>

                  <br>

                  <small>
                    <%= record.employee.employeeId %>
                  </small>

                </td>


                <td>
                  <%= record.employee.department || "-" %>
                </td>


                <td>
                  <%= new Date(record.date).toLocaleDateString("en-IN") %>
                </td>


                <td>

                  <%= record.checkIn
                    ? new Date(record.checkIn).toLocaleTimeString()
                    : "-"
                  %>

                </td>


                <td>

                  <%= record.checkOut
                    ? new Date(record.checkOut).toLocaleTimeString()
                    : "-"
                  %>

                </td>


                <td>

                  <span
                    class="status <%= record.status.toLowerCase().replace(' ', '-') %>"
                  >
                    <%= record.status %>
                  </span>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>

  </main>

</div>

</body>

</html>