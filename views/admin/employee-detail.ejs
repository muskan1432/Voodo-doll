<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Voodo - Employee Details</title>

  <link rel="stylesheet" href="/css/style.css">

  <style>
    .profile-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      font-size: 13px;
      color: #6b7280;
      font-weight: 600;
    }

    input,
    textarea {
      padding: 11px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      font-family: inherit;
    }

    textarea {
      min-height: 80px;
      resize: vertical;
    }

    .save-btn {
      margin-top: 20px;
      padding: 11px 20px;
      border: none;
      border-radius: 7px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      cursor: pointer;
    }

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 13px;
      border-bottom: 1px solid #e5e7eb;
    }

    th {
      color: #6b7280;
      font-size: 13px;
    }

    .status {
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .pending {
      background: #fef3c7;
      color: #92400e;
    }

    .approved {
      background: #dcfce7;
      color: #166534;
    }

    .rejected {
      background: #fee2e2;
      color: #991b1b;
    }

    @media (max-width: 700px) {
      .profile-grid {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }
    }
  </style>

</head>

<body>

<div class="app">

  <aside class="sidebar">

    <div class="brand">
      Voodo
    </div>

    <nav>

      <a href="/admin/dashboard">
        Dashboard
      </a>

      <a href="/admin/employees" class="active">
        Employees
      </a>

      <a href="/admin/attendance">
        Attendance
      </a>

      <a href="/payroll/admin">
        Payroll
      </a>

      <a href="/admin/leaves">
        Leave Requests
      </a>

      <a href="/admin/admins">
        Administrators
      </a>

    </nav>

    <a href="/logout" class="logout">
      Logout
    </a>

  </aside>


  <main class="main">

    <header class="topbar">

      <div>

        <h1>
          <%= employee.name %>
        </h1>

        <p>
          <%= employee.employeeId %>
        </p>

      </div>

    </header>


    <!-- EMPLOYEE INFORMATION -->

    <div class="panel">

      <div class="panel-header">

        <h2>Employee Information</h2>

      </div>


      <form
        action="/admin/employees/<%= employee._id %>/update"
        method="POST"
      >

        <div class="profile-grid">

          <div class="field">

            <label>Full Name</label>

            <input
              type="text"
              name="name"
              value="<%= employee.name %>"
              required
            >

          </div>


          <div class="field">

            <label>Email</label>

            <input
              type="email"
              value="<%= employee.email %>"
              disabled
            >

          </div>


          <div class="field">

            <label>Phone</label>

            <input
              type="tel"
              name="phone"
              value="<%= employee.phone || '' %>"
            >

          </div>


          <div class="field">

            <label>Department</label>

            <input
              type="text"
              name="department"
              value="<%= employee.department || '' %>"
            >

          </div>


          <div class="field">

            <label>Job Title</label>

            <input
              type="text"
              name="jobTitle"
              value="<%= employee.jobTitle || '' %>"
            >

          </div>


          <div class="field">

            <label>Salary</label>

            <input
              type="number"
              name="salary"
              min="0"
              value="<%= employee.salary || 0 %>"
            >

          </div>


          <div class="field full">

            <label>Address</label>

            <textarea name="address"><%= employee.address || '' %></textarea>

          </div>

        </div>


        <button
          type="submit"
          class="save-btn"
        >
          Save Changes
        </button>

      </form>

    </div>


    <!-- ATTENDANCE -->

    <div class="panel" style="margin-top: 20px;">

      <div class="panel-header">

        <h2>Recent Attendance</h2>

      </div>


      <div class="table-container">

        <table>

          <thead>

            <tr>
              <th>Date</th>
              <th>Check In</th>
              <th>Check Out</th>
              <th>Status</th>
            </tr>

          </thead>

          <tbody>

            <% if (attendance.length === 0) { %>

              <tr>
                <td colspan="4">
                  No attendance records.
                </td>
              </tr>

            <% } %>


            <% attendance.forEach(record => { %>

              <tr>

                <td>
                  <%= new Date(record.date).toLocaleDateString("en-IN") %>
                </td>

                <td>

                  <%= record.checkIn
                    ? new Date(record.checkIn).toLocaleTimeString()
                    : "-"
                  %>

                </td>

                <td>

                  <%= record.checkOut
                    ? new Date(record.checkOut).toLocaleTimeString()
                    : "-"
                  %>

                </td>

                <td>
                  <%= record.status %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>


    <!-- LEAVE HISTORY -->

    <div class="panel" style="margin-top: 20px;">

      <div class="panel-header">

        <h2>Leave History</h2>

      </div>


      <div class="table-container">

        <table>

          <thead>

            <tr>
              <th>Type</th>
              <th>From</th>
              <th>To</th>
              <th>Reason</th>
              <th>Status</th>
            </tr>

          </thead>

          <tbody>

            <% if (leaves.length === 0) { %>

              <tr>
                <td colspan="5">
                  No leave records.
                </td>
              </tr>

            <% } %>


            <% leaves.forEach(leave => { %>

              <tr>

                <td>
                  <%= leave.type %>
                </td>

                <td>
                  <%= new Date(leave.startDate)
                    .toLocaleDateString("en-IN") %>
                </td>

                <td>
                  <%= new Date(leave.endDate)
                    .toLocaleDateString("en-IN") %>
                </td>

                <td>
                  <%= leave.reason %>
                </td>

                <td>

                  <span class="status <%= leave.status.toLowerCase() %>">
                    <%= leave.status %>
                  </span>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>

  </main>

</div>

</body>

</html>