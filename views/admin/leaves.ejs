<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Voodo - Leave Requests</title>

  <link rel="stylesheet" href="/css/style.css">

  <style>
    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th,
    td {
      text-align: left;
      padding: 14px;
      border-bottom: 1px solid #e5e7eb;
    }

    th {
      color: #6b7280;
      font-size: 13px;
    }

    .status {
      display: inline-block;
      padding: 5px 10px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
    }

    .pending {
      background: #fef3c7;
      color: #92400e;
    }

    .approved {
      background: #dcfce7;
      color: #166534;
    }

    .rejected {
      background: #fee2e2;
      color: #991b1b;
    }

    .actions {
      display: flex;
      gap: 7px;
    }

    .actions button {
      border: none;
      border-radius: 6px;
      padding: 7px 10px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
    }

    .approve {
      background: #dcfce7;
      color: #166534;
    }

    .reject {
      background: #fee2e2;
      color: #991b1b;
    }

    .empty-state {
      color: #6b7280;
      padding: 20px;
    }
  </style>
</head>

<body>

<div class="app">

  <aside class="sidebar">

    <div class="brand">
      Voodo
    </div>

    <nav>

      <a href="/admin/dashboard">
        Dashboard
      </a>

      <a href="/admin/employees">
        Employees
      </a>

      <a href="/admin/attendance">
        Attendance
      </a>

      <a href="/payroll/admin">
        Payroll
      </a>

      <a href="/admin/leaves" class="active">
        Leave Requests
      </a>

      <a href="/admin/admins">
        Administrators
      </a>

    </nav>

    <a href="/logout" class="logout">
      Logout
    </a>

  </aside>


  <main class="main">

    <header class="topbar">

      <div>

        <h1>Leave Requests</h1>

        <p>
          Review and manage employee leave applications
        </p>

      </div>

    </header>


    <div class="panel">

      <div class="panel-header">

        <h2>Employee Leave Requests</h2>

      </div>


      <div class="table-container">

        <table>

          <thead>

            <tr>
              <th>Employee</th>
              <th>Department</th>
              <th>Type</th>
              <th>Dates</th>
              <th>Reason</th>
              <th>Status</th>
              <th>Action</th>
            </tr>

          </thead>


          <tbody>

            <% if (leaves.length === 0) { %>

              <tr>
                <td colspan="7" class="empty-state">
                  No leave requests found.
                </td>
              </tr>

            <% } %>


            <% leaves.forEach(leave => { %>

              <tr>

                <td>

                  <strong>
                    <%= leave.employee.name %>
                  </strong>

                  <br>

                  <small>
                    <%= leave.employee.employeeId %>
                  </small>

                </td>


                <td>
                  <%= leave.employee.department || "-" %>
                </td>


                <td>
                  <%= leave.type %>
                </td>


                <td>

                  <%= new Date(leave.startDate)
                    .toLocaleDateString("en-IN") %>

                  -

                  <%= new Date(leave.endDate)
                    .toLocaleDateString("en-IN") %>

                </td>


                <td>
                  <%= leave.reason %>
                </td>


                <td>

                  <span class="status <%= leave.status.toLowerCase() %>">
                    <%= leave.status %>
                  </span>

                </td>


                <td>

                  <% if (leave.status === "Pending") { %>

                    <div class="actions">

                      <form
                        action="/admin/leaves/<%= leave._id %>/approve"
                        method="POST"
                      >

                        <button class="approve">
                          Approve
                        </button>

                      </form>


                      <form
                        action="/admin/leaves/<%= leave._id %>/reject"
                        method="POST"
                      >

                        <button class="reject">
                          Reject
                        </button>

                      </form>

                    </div>

                  <% } else { %>

                    -

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    </div>

  </main>

</div>

</body>

</html>