<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Voodo - My Profile</title>

  <link rel="stylesheet" href="/css/style.css">

  <style>

    .profile-header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-bottom: 25px;
      margin-bottom: 25px;
      border-bottom: 1px solid #e5e7eb;
    }

    .profile-avatar {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: #2563eb;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      font-weight: 700;
      overflow: hidden;
    }

    .profile-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-header h2 {
      margin-bottom: 5px;
    }

    .profile-header p {
      color: #6b7280;
    }

    .profile-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }

    .profile-field label {
      display: block;
      color: #6b7280;
      font-size: 13px;
      margin-bottom: 7px;
      font-weight: 600;
    }

    .profile-field p {
      font-weight: 500;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    .editable {
      margin-top: 30px;
      padding-top: 25px;
      border-top: 1px solid #e5e7eb;
    }

    .editable h2 {
      margin-bottom: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-bottom: 18px;
    }

    .form-group label {
      color: #6b7280;
      font-size: 13px;
      font-weight: 600;
    }

    input,
    textarea {
      padding: 11px 12px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      font-family: inherit;
      font-size: 14px;
    }

    textarea {
      min-height: 90px;
      resize: vertical;
    }

    .save-btn {
      background: #2563eb;
      color: white;
      border: none;
      padding: 11px 20px;
      border-radius: 7px;
      font-weight: 600;
      cursor: pointer;
    }

    .success {
      background: #dcfce7;
      color: #166534;
      padding: 12px;
      border-radius: 7px;
      margin-bottom: 20px;
    }

    @media (max-width: 700px) {

      .profile-grid {
        grid-template-columns: 1fr;
      }

      .full-width {
        grid-column: auto;
      }

    }

  </style>

</head>

<body>

<div class="app">

  <aside class="sidebar">

    <div class="brand">
      Voodo
    </div>

    <nav>

      <a href="/employee/dashboard">
        Dashboard
      </a>

      <a href="/employee/profile" class="active">
        My Profile
      </a>

      <a href="/employee/attendance">
        Attendance
      </a>

      <a href="/employee/leave">
        Leave
      </a>

      <a href="/employee/payroll">
        Payroll
      </a>

    </nav>

    <a href="/logout" class="logout">
      Logout
    </a>

  </aside>


  <main class="main">

    <header class="topbar">

      <div>

        <h1>My Profile</h1>

        <p>
          View and manage your employee information
        </p>

      </div>

    </header>


    <div class="panel">


      <% if (message) { %>

        <div class="success">
          <%= message %>
        </div>

      <% } %>


      <!-- PROFILE HEADER -->

      <div class="profile-header">

        <div class="profile-avatar">

          <% if (employee.profilePicture) { %>

            <img
              src="<%= employee.profilePicture %>"
              alt="Profile picture"
            >

          <% } else { %>

            <%= employee.name.charAt(0).toUpperCase() %>

          <% } %>

        </div>


        <div>

          <h2>
            <%= employee.name %>
          </h2>

          <p>
            <%= employee.jobTitle || "Employee" %>
          </p>

        </div>

      </div>


      <!-- READ-ONLY INFORMATION -->

      <div class="profile-grid">

        <div class="profile-field">

          <label>Employee ID</label>

          <p>
            <%= employee.employeeId %>
          </p>

        </div>


        <div class="profile-field">

          <label>Email</label>

          <p>
            <%= employee.email %>
          </p>

        </div>


        <div class="profile-field">

          <label>Department</label>

          <p>
            <%= employee.department || "Not assigned" %>
          </p>

        </div>


        <div class="profile-field">

          <label>Job Title</label>

          <p>
            <%= employee.jobTitle || "Not assigned" %>
          </p>

        </div>


        <div class="profile-field">

          <label>Salary</label>

          <p>
            ₹<%= Number(employee.salary || 0).toLocaleString("en-IN") %>
          </p>

        </div>


        <div class="profile-field">

          <label>Joining Date</label>

          <p>
            <%= new Date(employee.joiningDate).toLocaleDateString("en-IN") %>
          </p>

        </div>

      </div>


      <!-- EDITABLE INFORMATION -->

      <div class="editable">

        <h2>Edit Personal Information</h2>


        <form
          action="/employee/profile/update"
          method="POST"
        >

          <div class="form-group">

            <label>
              Phone Number
            </label>

            <input
              type="tel"
              name="phone"
              value="<%= employee.phone || '' %>"
              placeholder="Enter phone number"
            >

          </div>


          <div class="form-group">

            <label>
              Address
            </label>

            <textarea
              name="address"
              placeholder="Enter your address"
            ><%= employee.address || '' %></textarea>

          </div>


          <div class="form-group">

            <label>
              Profile Picture URL
            </label>

            <input
              type="url"
              name="profilePicture"
              value="<%= employee.profilePicture || '' %>"
              placeholder="https://example.com/photo.jpg"
            >

          </div>


          <button
            type="submit"
            class="save-btn"
          >
            Save Changes
          </button>

        </form>

      </div>

    </div>

  </main>

</div>

</body>

</html>